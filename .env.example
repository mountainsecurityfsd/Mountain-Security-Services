# ==============================================================================
# Mountain Security Services (Pvt) Ltd - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / GitHub Pages)
# Safe for public web clients. Set in your local .env or GitHub Actions secrets.
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase Project Anon/Public Key (Find in Project Settings -> API)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE EDGE FUNCTION SECRETS (Supabase Edge Function: notify-new-candidate)
# NEVER put these in frontend code, HTML, or public GitHub files!
# Set these using: supabase secrets set KEY=VALUE
# Or via Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# ------------------------------------------------------------------------------
# Meta System User Access Token (with whatsapp_business_messaging permission)
WHATSAPP_ACCESS_TOKEN="EAA..."

# WhatsApp Phone Number ID (from Meta Developer Portal -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# Company recipient WhatsApp number in international format without '+' or spaces
# E.g. 923000266204 or 923299200111
WHATSAPP_RECIPIENT_NUMBER="923000266204"

# (Optional) Pre-approved Meta Message Template name (e.g. new_candidate_alert)
# If omitted, a clean text notification is dispatched during testing.
WHATSAPP_TEMPLATE_NAME="new_candidate_alert"

# ------------------------------------------------------------------------------
# 3. AI STUDIO RUNTIME VARIABLES
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
